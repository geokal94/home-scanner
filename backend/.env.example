# Postgres connection string. For local dev, use a Docker Postgres; for prod,
# Neon's connection string with `postgresql+psycopg://` (NOT just `postgresql://`).
DATABASE_URL=postgresql+psycopg://home_scanner:home_scanner@localhost:5432/home_scanner

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# --- Production-only secrets (leave blank for local dev) -----------------------

# Bearer secret for /internal/scrape; matched against `Authorization: Bearer`.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCRAPE_SECRET=

# Secret embedded in the Telegram webhook URL path. Telegram doesn't sign
# requests, so the URL itself is the auth. Generate the same way as SCRAPE_SECRET.
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated list of origins allowed to call the API (the public frontend's URL).
# Vercel preview URLs are matched separately via regex in code.
CORS_ORIGINS=

# Sentry DSN. Empty in local dev — observability is a no-op without it.
SENTRY_DSN=

# Public base URL of the deployed app (used to register the Telegram webhook).
PUBLIC_BASE_URL=

# --- Optional: HTTP proxy for the scraper (not needed for xe.gr) ---------------
# Kept for future multi-source support. Set all four to enable.
DATAIMPULSE_USER=
DATAIMPULSE_PASS=
DATAIMPULSE_HOST=
DATAIMPULSE_PORT=
